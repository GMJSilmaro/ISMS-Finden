# =============================================================================
# PROD — copy to the server as /opt/isms/prod/.env and fill in secrets.
# Never commit the real file. Separate DB volume + secrets from pre-prod.
# =============================================================================

COMPOSE_PROJECT_NAME=isms-prod
HOST_ENV_FILE=/opt/isms/prod/.env

IMAGE=ghcr.io/gmjsilmaro/isms-finden:prod

APP_BIND=0.0.0.0
APP_PORT=3000

POSTGRES_USER=isms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PROD_PASSWORD
POSTGRES_DB=isms_prod

NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://172.16.7.218:3000
BETTER_AUTH_URL=http://172.16.7.218:3000
AUTH_URL=http://172.16.7.218:3000

# Generate with: openssl rand -base64 48  (MUST differ from pre-prod)
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# RESEND_API_KEY=
# EMAIL_FROM=ISMS <noreply@example.com>

ALLOW_PUBLIC_REGISTER=false

# CRON_SECRET=CHANGE_ME_CRON_SECRET

LOG_LEVEL=info
MAINTENANCE_MODE=false
