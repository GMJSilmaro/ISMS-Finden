# =============================================================================
# PRE-PROD — copy to the server as /opt/isms/preprod/.env and fill in secrets.
# Never commit the real file. Compose reads this for ${VAR} substitution AND
# injects it into the app container via HOST_ENV_FILE.
# =============================================================================

COMPOSE_PROJECT_NAME=isms-preprod
HOST_ENV_FILE=/opt/isms/preprod/.env

# Image tag updated by GitHub Actions on each deploy (or set manually)
IMAGE=ghcr.io/gmjsilmaro/isms-finden:preprod

# Host port for the Next.js app (prod should use a different port)
APP_BIND=0.0.0.0
APP_PORT=3001

# Postgres (internal Compose network only)
POSTGRES_USER=isms
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PREPROD_PASSWORD
POSTGRES_DB=isms_preprod

# App — public URLs must match how users reach pre-prod (IP, hostname, or reverse proxy)
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://172.16.7.218:3001
BETTER_AUTH_URL=http://172.16.7.218:3001
AUTH_URL=http://172.16.7.218:3001

# Generate with: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET

# Optional — leave blank to disable Redis-backed cache / SAP session share
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional email
# RESEND_API_KEY=
# EMAIL_FROM=ISMS <noreply@example.com>

# Keep registration closed on shared servers
ALLOW_PUBLIC_REGISTER=false

# Optional cron protection for /api/cron/sap-sync
# CRON_SECRET=CHANGE_ME_CRON_SECRET

LOG_LEVEL=info
MAINTENANCE_MODE=false
