# Root .env.example for local Next.js (`cp .env.example .env.local`)
# Server pre-prod / prod templates: deploy/.env.preprod.example and deploy/.env.prod.example

DATABASE_URL="postgresql://isms:isms@localhost:5432/isms"
DIRECT_URL="postgresql://isms:isms@localhost:5432/isms"

AUTH_SECRET="dev-change-me"
BETTER_AUTH_SECRET="dev-change-me"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

STORAGE_ROOT=".data/uploads"
ALLOW_PUBLIC_REGISTER="false"
LOG_LEVEL="debug"

# Optional
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=
# EMAIL_FROM=
# CRON_SECRET=
# MAINTENANCE_MODE=false
