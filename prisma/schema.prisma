  id                   String              @id @default(cuid())
  tenantId             String              @map("tenant_id")
  saleId               String              @unique @map("sale_id")
  status               ReturnRequestStatus @default(pending_cs)
  requestNotes         String?             @map("request_notes")
  evaluationNotes      String?             @map("evaluation_notes")
  acceptedAt           DateTime?           @map("accepted_at")
  acceptedById         String?             @map("accepted_by_id")
  requestedById        String              @map("requested_by_id")
  evaluatedById        String?             @map("evaluated_by_id")
  approvedById         String?             @map("approved_by_id")
  evaluatedAt          DateTime?           @map("evaluated_at")
  approvedAt           DateTime?           @map("approved_at")
  completedAt          DateTime?           @map("completed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale        ServiceCenterSalesTransaction @relation(fields: [saleId], references: [id], onDelete: Cascade)
  requestedBy User                         @relation("ScReturnRequestedBy", fields: [requestedById], references: [id])
  evaluatedBy User?                        @relation("ScReturnEvaluatedBy", fields: [evaluatedById], references: [id], onDelete: SetNull)
  approvedBy  User?                        @relation("ScReturnApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  acceptedBy  User?                        @relation("ScReturnAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("service_center_return_requests")
}

