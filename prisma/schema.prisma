/**
 * Where a SAP master-data sync has got to in its current pass, per tenant and entity.
 *
 * Every SAP → ISMS sync reads its entity in full, repeatedly: one *pass* walks the whole
 * entity in key order, and when it ends another begins. That is what keeps ISMS in step
 * with edits made in SAP — `SerialNumberDetails` exposes no change timestamp, so there is
 * no way to ask SAP only for what moved.
 *
 * A pass does not have to fit in one run. `lastKey` is the key of the last row applied,
 * so the next run resumes with `$filter=<key> gt lastKey` and a small entity finishing in
 * one request is simply the case where a pass needs no resuming. Small and large entities
 * therefore share one code path, differing only in how many runs a pass takes:
 * `Warehouses` (~1.3k rows) finishes instantly, `SerialNumberDetails` (~4M) takes several
 * scheduled slices.
 *
 * Keyset, not `$skip`: paging by offset makes SAP re-scan from the start of the entity for
 * every page, which measurably degrades with depth on a multi-million-row read, and an
 * offset cannot be resumed in a later run anyway. Verified against the Service Layer that
 * keyset and offset paging return identical sequences with no gaps or repeats.
 */
model SapSyncCursor {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  /** Service Layer entity set, e.g. `SerialNumberDetails`. */
  entity   String

  /**
   * Key of the last row applied in the current pass, as text so one column serves both
   * numeric keys (OSRN.DocEntry) and string keys (ItemCode, CardCode, WarehouseCode).
   * Null means the pass starts at the beginning of the entity.
   *
   * Compared by SAP, never here: the Service Layer orders and filters strings under the
   * company database's collation, which is not byte order. Handing back exactly what SAP
   * returned keeps `gt` consistent with the `$orderby` that produced it.
   */
  lastKey       String?   @map("last_key")
  /** Rows read so far in the current pass — the numerator for progress. */
  passRows      Int       @default(0) @map("pass_rows")
  passStartedAt DateTime? @map("pass_started_at")
  /** SAP's row count for the entity, measured once per pass as the progress denominator. */
  totalAtSource Int?      @map("total_at_source")
  /** When a pass last reached the end of the entity. */
  lastCompletedAt DateTime? @map("last_completed_at")

  lastRunAt     DateTime? @map("last_run_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity])
  @@map("sap_sync_cursors")
}

