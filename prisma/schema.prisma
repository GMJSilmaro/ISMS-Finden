enum OfficialSalesImportRowStatus {
  pending
  success
  error
}

model OfficialSalesImportBatch {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  uploadedById String?  @map("uploaded_by_id")
  fileName     String?  @map("file_name")
