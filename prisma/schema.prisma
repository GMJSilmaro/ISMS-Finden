/// Tenant-wide ordering policy. `globalLockedWeekdays` are weekdays (0=Sun … 6=Sat)
/// on which no order may be created, requested, or approved (default: Sunday).
/// Optional daily time lock blocks create/approve during a Manila-local window
/// (`dailyLockStartMinutes` inclusive … `dailyLockEndMinutes` exclusive).
model OrderingPolicy {
  id                     String   @id @default(cuid())
  tenantId               String   @unique @map("tenant_id")
  globalLockedWeekdays   Int[]    @default([0]) @map("global_locked_weekdays")
  dailyLockEnabled       Boolean  @default(false) @map("daily_lock_enabled")
  /// Minutes from midnight (0–1439), Asia/Manila. Inclusive start of block window.
  dailyLockStartMinutes  Int?     @map("daily_lock_start_minutes")
  /// Minutes from midnight (0–1439), Asia/Manila. Exclusive end of block window.
  dailyLockEndMinutes    Int?     @map("daily_lock_end_minutes")
  /// Order modules company weekday + daily time locks apply to.
  lockAppliesToOrderTypes BranchOrderType[] @default([manual]) @map("lock_applies_to_order_types")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ordering_policies")
}

/// Configurable delivery-frequency code (e.g. F4 → weekly). Reusable across
/// branches; the description is shown when a branch selects the code.
model FrequencyCode {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  code        String
  frequency   DeliveryFrequency
  description String
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchSchedules BranchDeliverySchedule[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("frequency_codes")
}

/// Per-branch delivery cadence + ordering window used to gate order creation.
/// Weekdays are stored as integers 0=Sunday … 6=Saturday.
model BranchDeliverySchedule {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  branchId        String   @unique @map("branch_id")
  frequencyCodeId String   @map("frequency_code_id")
  /// Weekday(s) deliveries arrive on this branch.
  deliveryDays    Int[]    @map("delivery_days")
  /// Weekday(s) customers may place orders. Ordering is locked on the rest.
  orderDays       Int[]    @map("order_days")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  frequencyCode FrequencyCode @relation(fields: [frequencyCodeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([frequencyCodeId])
  @@map("branch_delivery_schedules")
}

