model Dealer {
  id              String       @id @default(cuid())
  tenantId        String       @map("tenant_id")
  name            String
  sapCode         String?      @map("sap_code")
  status          BranchStatus @default(active)
  areaId          String?      @map("area_id")
  dealerTypeId    String?      @map("dealer_type_id")
  dealerAreaId    String?      @map("dealer_area_id")
  modeOfPaymentId String?      @map("mode_of_payment_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area          Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  dealerType    DealerType?    @relation(fields: [dealerTypeId], references: [id], onDelete: SetNull)
  dealerArea    DealerArea?    @relation(fields: [dealerAreaId], references: [id], onDelete: SetNull)
  modeOfPayment ModeOfPayment? @relation(fields: [modeOfPaymentId], references: [id], onDelete: SetNull)
  branches      Branch[]
  aors          Aor[]
  salesReplacements SalesReplacement[]

  /**
   * `sapCode` is the identity, not the name. SAP legitimately carries several customers
   * under one `CardName` — a renumbering that kept both records, two branches of one
   * company — so a unique name would reject rows SAP considers perfectly valid, and did:
   * 78 of 1,138 customers, 11 of them the *active* record losing to a dead one that
   * happened to sort first. Names are therefore free to repeat, and anything resolving a
   * dealer by name (the branch import accepts either) may find more than one.
   *
   * Nullable and unique: legacy dealers predating the sync have no code, and Postgres
   * allows many NULLs in a unique index.
   */
  @@unique([tenantId, sapCode])
  @@index([tenantId])
  /** Replaces the index the dropped name constraint provided, for lookup and ordering. */
  @@index([tenantId, name])
  @@map("dealers")
}

