  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User?                    @relation("OfficialSalesImportBatchUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  rows       OfficialSalesImportRow[]

  @@index([tenantId, createdAt])
  @@map("official_sales_import_batches")
}

model OfficialSalesImportRow {
  id          String                       @id @default(cuid())
  tenantId    String                       @map("tenant_id")
  batchId     String                       @map("batch_id")
  serial      String
  /** DR DATE — delivery receipt date. Feeds BranchSalesTransactionDetail.deliveryDate. */
  drDate      DateTime?                    @map("dr_date") @db.Date
  /** DR NO. — delivery receipt number. Feeds BranchSalesTransactionDetail.deliveryNo. */
  drNo        String?                      @map("dr_no")
  /** DATE — sales invoice date. Feeds BranchSalesTransaction.transactionDate. */
  siDate      DateTime?                    @map("si_date") @db.Date
  /** SI/TRANS NO. — sales invoice / transaction number (legacy "Trans #"). */
  siNo        String?                      @map("si_no")
  branchSold  String?                      @map("branch_sold")
  /** WHSE_ADD | ADD | UPD | DEL — process dispatches by Action Key (UPD rejected). */
  action      String?
  dealer      String?
  brand       String?
  itemModel   String?                      @map("item_model")
  saleAmount  Decimal?                     @map("sale_amount") @db.Decimal(12, 2)
  packageName String?                      @map("package_name")
  result      String?
  status      OfficialSalesImportRowStatus @default(pending)
  processedAt DateTime?                    @map("processed_at")
  createdAt   DateTime                     @default(now()) @map("created_at")

  batch OfficialSalesImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([batchId])
  @@map("official_sales_import_rows")
}

model Aor {
  id                      String              @id @default(cuid())
  tenantId                String              @map("tenant_id")
  userId                  String              @map("user_id")
  name                    String?
  branchId                String?             @map("branch_id")
  warehouseId             String?             @map("warehouse_id")
  warehouseLocationId     String?             @map("warehouse_location_id")
  dealerId                String?             @map("dealer_id")
  serviceCenterId         String?             @map("service_center_id")
  serviceCenterLocationId String?             @map("service_center_location_id")
  status                  LookupRecordStatus  @default(active)
  createdById             String?             @map("created_by_id")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy             User?                  @relation("AorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseLocation     WarehouseLocation?     @relation(fields: [warehouseLocationId], references: [id], onDelete: SetNull)
  dealer                Dealer?                @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  serviceCenter         ServiceCenter?         @relation(fields: [serviceCenterId], references: [id], onDelete: SetNull)
  serviceCenterLocation ServiceCenterLocation? @relation(fields: [serviceCenterLocationId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([createdById])
  @@map("aors")
}

// --- BRS reference: Reason/Status (ISMS-v2 schema) ---

model ReasonStatus {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  category     ReasonStatusCategory
  name         String
  code         String
  recordStatus LookupRecordStatus   @default(active) @map("record_status")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codes               ReasonStatusCode[]
  pulloutsAsReason    BranchPullout[]      @relation("PulloutReasonStatus")
  scPulloutsAsReason  ServiceCenterPullout[] @relation("ScPulloutReasonStatus")

  @@unique([tenantId, category, code])
  @@index([tenantId, category])
  @@map("reason_statuses")
}

model ReasonStatusCode {
  id             String             @id @default(cuid())
  tenantId       String             @map("tenant_id")
  reasonStatusId String             @map("reason_status_id")
  name           String
  code           String
  /** Palette key for badges (emerald, amber, sky, …). Null → fallback by code. */
  color          String?
  sortOrder      Int                @default(0) @map("sort_order")
  isSystem       Boolean            @default(false) @map("is_system")
  recordStatus   LookupRecordStatus @default(active) @map("record_status")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant                    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reasonStatus              ReasonStatus      @relation(fields: [reasonStatusId], references: [id], onDelete: Cascade)
  branchInventories         BranchInventory[]
  branchDeliveries          BranchDelivery[]
  branchTransfers           BranchTransfer[]
  branchPulloutsWorkflow    BranchPullout[]   @relation("PulloutWorkflowStatus")
  branchPulloutsReasonCode  BranchPullout[]   @relation("PulloutReasonCode")
  serviceCenterInventories  ServiceCenterInventory[]
  serviceCenterDeliveries   ServiceCenterDelivery[]
  scPulloutsWorkflow        ServiceCenterPullout[] @relation("ScPulloutWorkflowStatus")
  scPulloutsReasonCode      ServiceCenterPullout[] @relation("ScPulloutReasonCode")
  branchSalesTransactionDetails BranchSalesTransactionDetail[]

  @@unique([tenantId, reasonStatusId, code])
  @@index([tenantId])
  @@map("reason_status_codes")
}

// --- BRS inventory ---

model SerialNumber {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  serialNo     String             @map("serial_no")
  modelId      String             @map("model_id")
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdById  String?            @map("created_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model             ProductModel              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdBy         User?                     @relation("SerialNumberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  branchInventories BranchInventory[]
  transferLines     BranchTransferLine[]
  pulloutLines      BranchPulloutLine[]
  stockCountLines   StockCountLine[]
  salesDetails      BranchSalesTransactionDetail[]
  salesReplacementsOriginal SalesReplacement[] @relation("SalesReplacementOriginalSn")
  salesReplacementsReplacement SalesReplacement[] @relation("SalesReplacementReplacementSn")
  branchBackloads   BranchBackload[]
  warehouseInventories WarehouseInventory[]
  deliveryLines     BranchDeliveryLine[]
  history           SerialNumberHistory[]
  serviceCenterInventories ServiceCenterInventory[]
  serviceCenterSales ServiceCenterSalesTransaction[]
  serviceCenterPulloutDetails ServiceCenterPulloutDetail[]
  serviceBackloads  ServiceBackload[]

  @@unique([tenantId, serialNo])
  @@index([tenantId])
  @@index([modelId])
  @@index([createdById])
  @@map("serial_numbers")
}

model BranchInventory {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  branchId       String   @map("branch_id")
  serialNumberId String   @map("serial_number_id")
  statusCodeId   String   @map("status_code_id")
  updatedById    String?  @map("updated_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serialNumber SerialNumber     @relation(fields: [serialNumberId], references: [id], onDelete: Cascade)
  statusCode   ReasonStatusCode @relation(fields: [statusCodeId], references: [id])
  updatedBy    User?            @relation("BranchInventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  stockCountLines StockCountLine[]

  @@unique([branchId, serialNumberId])
  @@index([tenantId, branchId, statusCodeId])
  @@map("branch_inventories")
}

model BranchPlanogram {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  branchId      String    @map("branch_id")
  modelId       String    @map("model_id")
  maxQty        Int       @default(1) @map("max_qty")
  effectiveFrom DateTime? @map("effective_from")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([branchId, modelId])
  @@index([tenantId])
  @@map("branch_planograms")
}

model BranchAllowedModel {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  branchId  String   @map("branch_id")
  modelId   String   @map("model_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([branchId, modelId])
  @@index([tenantId])
  @@map("branch_allowed_models")
}

model BranchMilSetting {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  branchId       String   @map("branch_id")
  modelId        String   @map("model_id")
  daysThreshold  Int      @default(30) @map("days_threshold")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([branchId, modelId])
  @@index([tenantId])
  @@map("branch_mil_settings")
}

// --- BRS planning (forecast + allocation) ---

model PlanningPeriod {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  label     String
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchTargets  BranchForecastTarget[]
  skuForecasts   BranchSkuForecast[]
  allocations    BranchAllocation[]
  demandPlanningRuns DemandPlanningRun[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("planning_periods")
}

model BranchForecastTarget {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  periodId       String   @map("period_id")
  branchId       String   @map("branch_id")
  revenueTarget  Decimal  @map("revenue_target") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period PlanningPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([periodId, branchId])
  @@index([tenantId])
  @@map("branch_forecast_targets")
}

model BranchAllocation {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  periodId      String   @map("period_id")
  branchId      String   @map("branch_id")
  modelId       String   @map("model_id")
  planogramMax  Int      @map("planogram_max")
  currentStock  Int      @map("current_stock")
  gapQty        Int      @map("gap_qty")
  computedAt    DateTime @map("computed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period PlanningPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([periodId, branchId, modelId])
  @@index([tenantId, periodId])
  @@map("branch_allocations")
}

/// Per-SKU SFE monthly forecast (Process I import). Quota may derive from Σ FC ₱.
model BranchSkuForecast {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  periodId     String   @map("period_id")
  branchId     String   @map("branch_id")
  modelId      String   @map("model_id")
  forecastQty  Int      @map("forecast_qty")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period PlanningPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([periodId, branchId, modelId])
  @@index([tenantId, periodId])
  @@index([tenantId, branchId])
  @@map("branch_sku_forecasts")
}

/// Display units netted off MIL when computing month allocation. Editable register.
model BranchDisplayUnit {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  branchId  String   @map("branch_id")
  modelId   String   @map("model_id")
  qty       Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([branchId, modelId])
  @@index([tenantId])
  @@map("branch_display_units")
}

/// Versioned Demand Planning document (DP-YYYYMM-nnn). Process I → Ordering handoff.
model DemandPlanningRun {
  id                       String            @id @default(cuid())
  tenantId                 String            @map("tenant_id")
  periodId                 String?           @map("period_id")
  documentNumber           String            @map("document_number")
  version                  Int               @default(1)
  name                     String
  status                   DemandPlanStatus  @default(draft)
  origin                   DemandPlanOrigin  @default(wizard)
  salesPeriodLabel         String            @map("sales_period_label")
  salesPeriodStart         DateTime          @map("sales_period_start")
  salesPeriodEnd           DateTime          @map("sales_period_end")
  historyStart             DateTime          @map("history_start")
  historyEnd               DateTime          @map("history_end")
  /// When set, overrides every branch's delivery frequency for this run.
  deliveryFrequencyPerMonth Decimal?         @map("delivery_frequency_per_month") @db.Decimal(8, 4)
  monthBasisDays           Decimal           @default(30.5) @map("month_basis_days") @db.Decimal(6, 2)
  deriveQuotaFromForecast  Boolean           @default(true) @map("derive_quota_from_forecast")
  quotaOverridePhp         Decimal?          @map("quota_override_php") @db.Decimal(14, 2)
  floorAllocationAtZero    Boolean           @default(true) @map("floor_allocation_at_zero")
  roundUpSlowMovers        Boolean           @default(true) @map("round_up_slow_movers")
  sourceSnapshot           Json?             @map("source_snapshot")
  computedAt               DateTime?         @map("computed_at")
  releasedAt               DateTime?         @map("released_at")
  createdById              String            @map("created_by_id")
  releasedById             String?           @map("released_by_id")
  supersededById           String?           @map("superseded_by_id")
  parentRunId              String?           @map("parent_run_id")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period     PlanningPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdBy  User            @relation("DemandPlanningRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy User?           @relation("DemandPlanningRunReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  parentRun  DemandPlanningRun?  @relation("DemandPlanningRunVersions", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns  DemandPlanningRun[] @relation("DemandPlanningRunVersions")
  supersededBy DemandPlanningRun? @relation("DemandPlanningRunSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   DemandPlanningRun[] @relation("DemandPlanningRunSupersedes")
  lines        DemandPlanningLine[]
  overrideLogs DemandPlanningOverrideLog[]
  branchOrders BranchOrder[]

  @@unique([tenantId, documentNumber, version])
  @@index([tenantId, status])
  @@index([tenantId, salesPeriodLabel])
  @@map("demand_planning_runs")
}

model DemandPlanningLine {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  runId             String   @map("run_id")
  branchId          String   @map("branch_id")
  modelId           String   @map("model_id")
  seriesCode        String?  @map("series_code")
  onPlanogram       Boolean  @default(true) @map("on_planogram")
  srp               Decimal  @db.Decimal(12, 2)
  historyQty        Decimal  @map("history_qty") @db.Decimal(12, 4)
  historyPhp        Decimal  @map("history_php") @db.Decimal(14, 2)
  hmix              Decimal  @db.Decimal(12, 8)
  adjMix            Decimal  @map("adj_mix") @db.Decimal(12, 8)
  milQty            Int      @map("mil_qty")
  milPhp            Decimal  @map("mil_php") @db.Decimal(14, 2)
  displayUnits      Int      @default(0) @map("display_units")
  onHand            Int      @map("on_hand")
  forecastQty       Int      @map("forecast_qty")
  forecastPhp       Decimal  @map("forecast_php") @db.Decimal(14, 2)
  allocQty          Int      @map("alloc_qty")
  allocPhp          Decimal  @map("alloc_php") @db.Decimal(14, 2)
  cycleQty          Int      @map("cycle_qty")
  drop1Qty          Int      @map("drop1_qty")
  drop1Php          Decimal  @map("drop1_php") @db.Decimal(14, 2)
  /// Frozen suggested qty at release (after planner overrides).
  releasedDrop1Qty  Int?     @map("released_drop1_qty")
  minLevelDays      Decimal  @map("min_level_days") @db.Decimal(8, 4)
  quotaPhp          Decimal  @map("quota_php") @db.Decimal(14, 2)
  deliveryFreqMonth Decimal  @map("delivery_freq_month") @db.Decimal(8, 4)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    DemandPlanningRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  branch Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  overrideLogs DemandPlanningOverrideLog[]

  @@unique([runId, branchId, modelId])
  @@index([tenantId, runId])
  @@index([tenantId, branchId])
  @@map("demand_planning_lines")
}

model DemandPlanningOverrideLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  runId      String   @map("run_id")
  lineId     String?  @map("line_id")
  field      String
  previousValue String @map("previous_value")
  newValue   String   @map("new_value")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    DemandPlanningRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  line   DemandPlanningLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  user   User              @relation("DemandPlanningOverrideBy", fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, runId])
  @@map("demand_planning_override_logs")
}

// --- BRS orders ---

model BranchOrder {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  branchId        String            @map("branch_id")
  brandId         String?           @map("brand_id")
  packageTypeId   String?           @map("package_type_id")
  orderType       BranchOrderType   @map("order_type")
  status          BranchOrderStatus @default(pending_tl)
  orderNumber     String            @map("order_number")
  notes           String?
  spaRemarks      String?           @map("spa_remarks")
  deliveryDueDate DateTime?         @map("delivery_due_date")
  processedAt     DateTime?         @map("processed_at")
  sapDocRef       String?           @map("sap_doc_ref")
  /// When set, this order was released (or mid-cycle sent) from a Demand Planning run.
  demandPlanningRunId String?       @map("demand_planning_run_id")
  createdById     String            @map("created_by_id")
  approvedById    String?           @map("approved_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  brand          Brand?                     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  packageType    PackageType?               @relation(fields: [packageTypeId], references: [id], onDelete: SetNull)
  demandPlanningRun DemandPlanningRun?      @relation(fields: [demandPlanningRunId], references: [id], onDelete: SetNull)
  createdBy      User                       @relation("BranchOrderCreatedBy", fields: [createdById], references: [id])
  approvedBy     User?                      @relation("BranchOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  details        BranchOrderDetail[]
  approvalLevels BranchOrderApprovalLevel[]
  deliveries     BranchDelivery[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, processedAt])
  @@index([demandPlanningRunId])
  @@map("branch_orders")
}

model BranchOrderDetail {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  modelId     String   @map("model_id")
  quantity    Int
  approvedQty Int?     @map("approved_qty")
  remarks     String?
  amount      Decimal? @db.Decimal(12, 2)

  order BranchOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  model ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("branch_order_details")
}

model BranchOrderApprovalLevel {
  id           String    @id @default(cuid())
  orderId      String    @map("order_id")
  level        Int
  roleSlug     String    @map("role_slug")
  approvedAt   DateTime? @map("approved_at")
  approvedById String?   @map("approved_by_id")
  rejectedAt   DateTime? @map("rejected_at")
  comment      String?

  order      BranchOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("BranchOrderApprovalLevelApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([orderId, level])
  @@map("branch_order_approval_levels")
}

// --- BRS logistics & sales ---

model BranchDelivery {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  branchId     String    @map("branch_id")
  orderId      String?   @map("order_id")
  deliveryNo   String    @map("delivery_no")
  statusCodeId String    @map("status_code_id")
  acceptedAt   DateTime? @map("accepted_at")
  sapDocRef    String?   @map("sap_doc_ref")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order      BranchOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  statusCode ReasonStatusCode @relation(fields: [statusCodeId], references: [id])
  lines      BranchDeliveryLine[]
  backloads  BranchBackload[]

  @@unique([tenantId, deliveryNo])
  @@unique([tenantId, orderId])
  @@index([tenantId, sapDocRef])
  @@index([tenantId, branchId, statusCodeId])
  @@map("branch_deliveries")
}

model BranchTransfer {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  fromBranchId String   @map("from_branch_id")
  toBranchId   String   @map("to_branch_id")
  transferNo   String   @map("transfer_no")
  statusCodeId String   @map("status_code_id")
  notes        String?
  createdById  String?  @map("created_by_id")
